{
  "name": "digital-worker-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md,mjs}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md,mjs}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
