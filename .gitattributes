# Normalize line endings: everything text is LF in repo and working tree,
# so Linux containers can execute mounted scripts on Windows checkouts.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
